# Copia este archivo como backend/.env y completa los valores.
# NUNCA subas backend/.env al repositorio.

# --- Django ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=UTC

# --- PostgreSQL ---
DB_NAME=sgim_cmch
DB_USER=sgim_app
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0

# --- Sesión y seguridad de la API ---
# Duración máxima absoluta de la sesión (segundos, 8 h) e inactividad máxima (30 min)
SGIM_SESSION_ABSOLUTE_TIMEOUT=28800
SGIM_SESSION_IDLE_TIMEOUT=1800
DJANGO_LOGIN_THROTTLE_RATE=5/min

# --- Incidencias ---
# Tamaño máximo de la imagen de evidencia en bytes (5 MB)
INCIDENT_ATTACHMENT_MAX_BYTES=5242880
